# Copia questo file in .env e compila i valori. Il file .env non va mai nel repository.

# Database
POSTGRES_PASSWORD=cambia-questa-password

# Chiave per firmare le sessioni: genera con `openssl rand -hex 32`
JWT_SECRET=
JWT_MINUTI=30

# Nome con cui gli operatori aprono il CRM (usato per il certificato autofirmato)
CRM_HOSTNAME=crm.local
HTTP_PORT=80
HTTPS_PORT=443

# Amministratore locale di emergenza, creato al primo avvio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Active Directory (LDAPS). Vuoto = entra solo l'amministratore locale.
AD_SERVER=
AD_PORT=636
AD_USE_SSL=true
AD_DOMAIN=
# Certificato della CA interna, da mettere nella cartella certs/ (es. /certs/ca-ad.crt)
AD_CA_FILE=

# Processi del backend (4 bastano per circa 50 operatori)
WEB_WORKERS=4
